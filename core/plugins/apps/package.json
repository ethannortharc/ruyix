{
  "name": "@ruyix/apps",
  "version": "0.4.1",
  "description": "The App Center: install Linux software into the nookbox box with one click; graphical apps open as windows on Ruyix's desktop (a virtual display per app, drawn in the browser over VNC). Part of Ruyix, the agent OS built on DSH (DeepSeek Harness).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ruyix",
    "agent-os"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethannortharc/ruyix.git",
    "directory": "core/plugins/apps"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node check.mjs"
  },
  "devDependencies": {
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.49.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "lib",
    "README.md",
    "browser-mcp.mjs"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
