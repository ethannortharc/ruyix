{
  "name": "@ruyix/web",
  "version": "0.4.1",
  "description": "Searching the web and fetching pages for every agent, as this Ruyix is set up to: DeepSeek, Tavily, 博查, Exa or Brave for search; a guarded direct fetch, Jina Reader or DeepSeek Fetch for pages — keys kept like model keys. Part of Ruyix, the agent OS built on DSH (DeepSeek Harness).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ruyix",
    "agent-os"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethannortharc/ruyix.git",
    "directory": "core/plugins/web"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "lucide-react": "^1.49.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "web-mcp.mjs",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
