{
  "name": "@ruyix/world",
  "version": "0.4.1",
  "description": "The interactive desk: the whole desktop as one map you play on — the old map or the star map — every page, task and agent a place on it. Part of Ruyix, the agent OS built on DSH (DeepSeek Harness).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ruyix",
    "agent-os"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethannortharc/ruyix.git",
    "directory": "core/plugins/world"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./kit": "./src/kit.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "src",
    "MAKE-A-MAP.md",
    "template"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
