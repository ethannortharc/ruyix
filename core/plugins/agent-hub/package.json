{
  "name": "@ruyix/agent-hub",
  "version": "0.4.1",
  "description": "Agent Hub: one command center for every agent and Agent Team — live working status, attention inbox, team boards, quick replies. Part of Ruyix, the agent OS built on DSH (DeepSeek Harness).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ruyix",
    "agent-os"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethannortharc/ruyix.git",
    "directory": "core/plugins/agent-hub"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "devDependencies": {
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.49.0",
    "motion": "^12.43.0"
  },
  "files": [
    "index.js",
    "client.js",
    "endpoints.js",
    "store.js",
    "runtimes.js",
    "install.js",
    "login.js",
    "platform.js",
    "keys.js",
    "skills.js",
    "sessions.js",
    "session-text.js",
    "mcp-env.mjs",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "mirror.js",
    "task-feed.js",
    "task-tools.js",
    "agent-tools.js",
    "skill-tools.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "optionalDependencies": {
    "@ruyix/shell": "file:../../shell"
  }
}
