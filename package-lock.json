{
  "name": "ruyix",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ruyix",
      "license": "MIT",
      "workspaces": [
        "core/shell",
        "core/board",
        "core/connectors",
        "core/workbench",
        "core/messages",
        "core/plugins/*",
        "packs/*"
      ]
    },
    "core/board": {
      "name": "@ruyix/board",
      "version": "0.4.0",
      "license": "MIT",
      "peerDependencies": {
        "react": "^18"
      },
      "peerDependenciesMeta": {
        "react": {
          "optional": true
        }
      }
    },
    "core/connectors": {
      "name": "@ruyix/connectors",
      "version": "0.4.0",
      "license": "MIT",
      "devDependencies": {
        "esbuild": "^0.25.12",
        "lucide-react": "^1.49.0"
      },
      "peerDependencies": {
        "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
      }
    },
    "core/messages": {
      "name": "@ruyix/messages",
      "version": "0.4.0",
      "license": "MIT",
      "bin": {
